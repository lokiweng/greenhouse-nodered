    {
        "id": "fn_manual_control",
        "type": "function",
        "z": "tab_gh",
        "name": "Manual Override → Firebase + MQTT",
        "func": "// Write manual override to Firebase /actuators/status\nvar device  = msg.topic;   // 'fan' | 'pump' | 'growLight'\nvar state   = msg.payload === 'ON';\n\n// Build Firebase PATCH URL for just this device\nmsg.url     = 'https://iot-greenhouse-assignment-default-rtdb.firebaseio.com/actuators/status/' + device + '.json?auth=s85BRUupLYDqKHsYofadrGpOVpy5KfffYXk6nvNV';\nmsg.method  = 'PATCH';\nmsg.headers = { 'Content-Type': 'application/json' };\nmsg.payload = JSON.stringify({ state: state, manual: true, updated: new Date().toISOString() });\n\nreturn msg;\n",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 430,
        "y": 560,
        "wires": [
