    {
        "id": "fn_save_threshold",
        "type": "function",
        "z": "tab_gh",
        "name": "Save Threshold → Firebase /thresholds",
        "func": "var key = msg.topic;\nvar val = parseInt(msg.payload);\n\nmsg.url     = 'https://iot-greenhouse-assignment-default-rtdb.firebaseio.com/thresholds.json?auth=s85BRUupLYDqKHsYofadrGpOVpy5KfffYXk6nvNV';\nmsg.method  = 'PATCH';\nmsg.headers = { 'Content-Type': 'application/json' };\nmsg.payload = JSON.stringify({ [key]: val });\n\nnode.status({ fill:'green', shape:'dot', text: key + ' → ' + val });\nreturn msg;\n",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
