    {
        "id": "fn_check_new_alert",
        "type": "function",
        "z": "tab_gh",
        "name": "Toast if new alert",
        "func": "var d = msg.payload;\nif (!d || typeof d !== 'object') return null;\n\nvar entries = Object.values(d);\nif (entries.length === 0) return null;\n\nvar latest = entries[entries.length - 1];\nvar lastKey = Object.keys(d).pop();\n\n// Only toast if we haven't seen this key before\nvar seen = context.get('lastAlertKey') || '';\nif (lastKey === seen) return null;\ncontext.set('lastAlertKey', lastKey);\n\nvar icon = latest.level === 'critical' ? '🔴 CRITICAL' : '⚠️ WARNING';\nreturn { payload: icon + ': ' + latest.message };\n",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
