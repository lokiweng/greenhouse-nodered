        "id": "fn_dashboard_to_mqtt",
        "type": "function",
        "z": "tab_mqtt",
        "name": "Dashboard override → MQTT command",
        "func": "// Receives msg.topic = 'fan'|'pump'|'growLight', msg.payload = 'ON'|'OFF'\nvar device = msg.topic;\nvar state  = msg.payload === 'ON';\nmsg.payload = JSON.stringify({ [device]: state, manual: true });\nmsg.topic   = 'greenhouse/commands';\nnode.status({ fill:'orange', shape:'dot',\n  text: 'CMD ' + device + ' → ' + (state ? 'ON' : 'OFF') });\nreturn msg;\n",
        "outputs": 1,
