    {
        "id": "fn_check_alerts",
        "type": "function",
        "z": "tab_mqtt",
        "name": "Check thresholds → generate alert",
        "func": "var d   = msg.payload;\nvar thr = flow.get('thresholds') || {\n  temp_fan_on: 30, temp_fan_off: 25,\n  soil_pump_on: 30, soil_pump_off: 70\n};\n\nvar alerts = [];\n\nif (d.temperature > thr.temp_fan_on + 5)\n  alerts.push({ level:'critical', message:'Temperature critically high: ' + d.temperature + '°C' });\nelse if (d.temperature > thr.temp_fan_on)\n  alerts.push({ level:'warning',  message:'Temperature high: ' + d.temperature + '°C' });\n\nif (d.humidity > 85)\n  alerts.push({ level:'warning',  message:'Humidity very high: ' + d.humidity + '%' });\n\nif (d.soil_pct < thr.soil_pump_on - 10)\n  alerts.push({ level:'critical', message:'Soil critically dry: ' + d.soil_pct + '%' });\nelse if (d.soil_pct < thr.soil_pump_on)\n  alerts.push({ level:'warning',  message:'Soil moisture low: ' + d.soil_pct + '%' });\n\nif (alerts.length === 0) return null;\n\nvar ts = Date.now();\nalerts.forEach(function(a, i) { \n    // Use toLocaleString to respect the local timezone instead of forcing UTC\n    a.timestamp = new Date(ts + i).toLocaleString(\"en-MY\", { timeZone: \"Asia/Kuala_Lumpur\" }); \n});\nmsg.alerts = alerts;\nreturn msg;\n",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 700,
        "y": 120,
        "wires": [
            [
                "fn_build_alert_write"
            ]
        ]
    },
    {
        "id": "fn_build_alert_write",
        "type": "function",
        "z": "tab_mqtt",
        "name": "Build POST /alerts (one per alert)",
        "func": "var secret = env.get('FIREBASE_SECRET');\nvar base = 'https://iot-greenhouse-assignment-default-rtdb.firebaseio.com/alerts.json?auth=s85BRUupLYDqKHsYofadrGpOVpy5KfffYXk6nvNV' + secret;\nvar msgs = [];\nmsg.alerts.forEach(function(a) {\n  msgs.push({\n    url: base,\n    method: 'POST',\n    headers: { 'Content-Type': 'application/json' },\n    payload: JSON.stringify(a)\n  });\n});\n// Send each alert as a separate message\nreturn msgs.map(function(m) { return { payload: m.payload, url: m.url, method: m.method, headers: m.headers }; });\n",
