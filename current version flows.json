    {
        "id": "fn_cache_thresholds",
        "type": "function",
        "z": "tab_mqtt",
        "name": "Cache thresholds in flow context",
        "func": "var d = msg.payload;\nif (!d || typeof d !== 'object') return null;\n// Merge with existing cached thresholds\nvar existing = flow.get('thresholds') || {};\nvar merged = Object.assign({}, existing, d);\nflow.set('thresholds', merged);\nnode.status({ fill:'green', shape:'dot', text: JSON.stringify(merged) });\n// Also persist to Firebase\nvar secret = env.get('FIREBASE_SECRET');\nmsg.url     = 'https://iot-greenhouse-assignment-default-rtdb.firebaseio.com/thresholds.json?auth=' + secret;\nmsg.method  = 'PATCH';\nmsg.headers = { 'Content-Type': 'application/json' };\nmsg.payload = JSON.stringify(d);\nreturn msg;\n",
        "outputs": 1,
        "x": 440,
        "y": 400,
        "wires": [
            [
                "http_patch_thresholds"
            ]
        ]
    },
