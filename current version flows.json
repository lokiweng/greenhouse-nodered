    {
        "id": "fn_validate_sensors",
        "type": "function",
        "z": "tab_mqtt",
        "name": "Validate & normalise sensor data",
        "func": "var d = msg.payload;\nif (!d || typeof d !== 'object') {\n  node.warn('Invalid sensor payload: ' + JSON.stringify(d));\n  return null;\n}\n\n// Accept both raw ADC and pre-converted % values from ESP32\nvar temp     = parseFloat(d.temperature);\nvar humi     = parseFloat(d.humidity);\nvar soilRaw  = parseInt(d.soil_raw)   || 0;\nvar soilPct  = parseInt(d.soil_pct)   || Math.round((1 - soilRaw / 4095) * 100);\nvar lightRaw = parseInt(d.light_raw)  || 0;\nvar lightPct = parseInt(d.light_pct)  || Math.round(lightRaw / 4095 * 100);\n\nif (isNaN(temp) || isNaN(humi)) {\n  node.warn('Missing temp/humi in payload');\n  return null;\n}\n\nmsg.payload = {\n  temperature: parseFloat(temp.toFixed(1)),\n  humidity:    parseFloat(humi.toFixed(1)),\n  soil_raw:    soilRaw,\n  soil_pct:    soilPct,\n  light_raw:   lightRaw,\n  light_pct:   lightPct,\n  timestamp:   new Date().toISOString()\n};\nnode.status({ fill:'green', shape:'dot',\n  text: 'T:' + temp.toFixed(1) + '°C H:' + humi.toFixed(1) + '%' });\nreturn msg;\n",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 440,
        "y": 80,
        "wires": [
            [
                "fn_build_sensor_write",
                "fn_check_alerts"
            ]
        ]
    },
