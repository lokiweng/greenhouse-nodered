    {
        "id": "fn_validate_actuators",
        "type": "function",
        "z": "tab_mqtt",
        "name": "Validate actuator payload",
        "func": "var d = msg.payload;\nif (!d || typeof d !== 'object') {\n  node.warn('Invalid actuator payload');\n  return null;\n}\n\n// Normalise: accept boolean or string ON/OFF\nfunction toState(v) {\n  if (typeof v === 'boolean') return v;\n  if (typeof v === 'string')  return v.toUpperCase() === 'ON';\n  return !!v;\n}\n\nvar now = new Date().toISOString();\nmsg.payload = {\n  fan:       { state: toState(d.fan),       updated: now, manual: false },\n  pump:      { state: toState(d.pump),      updated: now, manual: false },\n  growLight: { state: toState(d.growLight), updated: now, manual: false }\n};\n\nvar summary = [];\nif (msg.payload.fan.state)       summary.push('Fan ON');\nif (msg.payload.pump.state)      summary.push('Pump ON');\nif (msg.payload.growLight.state) summary.push('Light ON');\nnode.status({ fill:'blue', shape:'dot',\n  text: summary.length ? summary.join(', ') : 'All OFF' });\nreturn msg;\n",
        "outputs": 1,
        "x": 440,
        "y": 260,
        "wires": [
