    {
        "id": "2a1e6c1d90737604",
        "type": "function",
        "z": "2a630d8feeee37fc",
        "name": "Parse Sensor Data → Route to Widgets",
        "func": "var d = msg.payload;\nif (!d || typeof d !== 'object') { node.warn('No sensor data'); return null; }\n\nvar temp     = parseFloat(d.temperature) || 0;\nvar humi     = parseFloat(d.humidity)    || 0;\nvar soilPct  = parseInt(d.soil_pct)      || 0;\nvar lightPct = parseInt(d.light_pct)     || 0;\nvar soilRaw  = parseInt(d.soil_raw)      || 0;\n\n// Soil status label\nvar soilLabel  = soilPct < 30 ? 'DRY 🔴' : soilPct > 80 ? 'WET SATURATED 🔵' : 'GOOD 🟢';\nvar soilColour = soilPct < 30 ? '#e63946' : soilPct > 80 ? '#2196F3' : '#4CAF50';\n\n// Light status\nvar hour = new Date().getHours();\nvar isDaytime = hour >= 7 && hour < 18;\nvar lightWarn = isDaytime && lightPct < 20;\nvar lightLabel = lightWarn ? 'LOW ⚠️' : (lightPct < 20 ? 'DARK 🌙' : 'BRIGHT ☀️');\nvar lightColour = lightWarn ? '#FF9800' : (lightPct < 20 ? '#607D8B' : '#FFC107');\n\n// Temp status\nvar tempColour = temp > 30 ? '#e63946' : temp < 18 ? '#2196F3' : '#4CAF50';\nvar tempLabel  = temp > 30 ? 'HIGH 🔴' : temp < 18 ? 'COLD 🔵' : 'NORMAL 🟢';\n\nreturn [\n  { payload: temp },\n  { payload: humi },\n  { payload: soilPct },\n  { payload: lightPct },\n  { payload: `<div style=\"text-align:center;margin-top:6px\"><span style=\"background:${soilColour};color:#fff;padding:4px 14px;border-radius:20px;font-weight:bold\">${soilLabel}</span><br><small style='color:#aaa'>Raw ADC: ${soilRaw}</small></div>` },\n  { payload: `<div style=\"text-align:center;margin-top:6px\"><span style=\"background:${lightColour};color:#fff;padding:4px 14px;border-radius:20px;font-weight:bold\">${lightLabel}</span></div>` },\n  { payload: `<div style=\"text-align:center;margin-top:6px\"><span style=\"background:${tempColour};color:#fff;padding:4px 14px;border-radius:20px;font-weight:bold\">${tempLabel}</span></div>` },\n  { payload: new Date().toLocaleString('en-MY') },\n  { payload: temp, topic: 'Temperature (°C)' },\n  { payload: humi, topic: 'Humidity (%)' },\n  { payload: soilPct, topic: 'Soil Moisture (%)' }\n];\n",
        "outputs": 10,
        "x": 720,
        "y": 40,
        "wires": [
            [
                "7ab0becaf4bb21b6"
            ],
            [
                "901873659ac14020"
            ],
            [
                "f2522dc8a33d9468"
            ],
            [
                "ff3a94dac09633aa"
            ],
            [
                "200282d165405b3d"
            ],
            [
                "eaf213b24bd9cf29"
            ],
            [
                "fa9c0864c885f8b4"
            ],
            [
                "7acc3e8cc987b778"
            ],
            [
                "5366ac0c71bb8152"
            ],
            [
                "5366ac0c71bb8152"
            ]
        ]
    },
    {
        "id": "408412408e65a584",
        "type": "function",
        "z": "2a630d8feeee37fc",
        "name": "Parse Actuator Status",
        "func": "var d = msg.payload;\nif (!d || typeof d !== 'object') return null;\n\nvar fanOn   = d.fan   && d.fan.state;\nvar pumpOn  = d.pump  && d.pump.state;\nvar lightOn = d.growLight && d.growLight.state;\n\nfunction badge(on, labelOn, labelOff) {\n  var colour = on ? '#4CAF50' : '#9E9E9E';\n  return `<span style=\"background:${colour};color:#fff;padding:3px 12px;border-radius:20px;font-weight:bold\">${on ? labelOn : labelOff}</span>`;\n}\n\nreturn [\n  { payload: badge(fanOn,   '● FAN ON',   '○ FAN OFF')   },\n  { payload: badge(pumpOn,  '● PUMP ON',  '○ PUMP OFF')  },\n  { payload: badge(lightOn, '● LIGHT ON', '○ LIGHT OFF') }\n];\n",
        "outputs": 3,
        "x": 720,
        "y": 100,
        "wires": [
            [
                "45e0c8a1d17f7921"
            ],
            [
                "0ad637cbb459395a"
            ],
            [
                "03b38dc8072416a1"
            ]
        ]
    },
    {
        "id": "8c1aceb4fabd6343",
        "type": "function",
        "z": "2a630d8feeee37fc",
        "name": "Parse Alert Log",
        "func": "var d = msg.payload;\nif (!d || typeof d !== 'object') {\n  return { payload: '<p style=\"color:#aaa\">No alerts recorded.</p>' };\n}\n\nvar rows = Object.values(d).reverse().map(function(a) {\n  var colour = a.level === 'critical' ? '#e63946' : '#FF9800';\n  var icon   = a.level === 'critical' ? '🔴' : '⚠️';\n  var time   = a.timestamp ? new Date(a.timestamp).toLocaleString('en-MY') : '';\n  return `<div style=\"border-left:4px solid ${colour};padding:6px 10px;margin:4px 0;background:rgba(0,0,0,0.1)\">`\n    + `<strong>${icon} ${a.message}</strong><br><small style='color:#aaa'>${time}</small></div>`;\n}).join('');\n\nreturn { payload: rows };\n",
        "outputs": 1,
        "x": 720,
        "y": 160,
        "wires": [
            [
                "33e99183eca0edad"
            ]
        ]
    },
